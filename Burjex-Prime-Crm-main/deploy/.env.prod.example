# ============================================================================
#  Burjex Prime — SINGLE-SERVER production env (CRM + B-Trader)
#
#  Copy to deploy/.env.prod and fill in EVERY "CHANGE_ME".
#  Generate secrets with:   openssl rand -hex 32
#  NEVER commit the filled-in .env.prod (it is git-ignored by deploy/.gitignore).
# ============================================================================

# ── Domains ─────────────────────────────────────────────────────────────────
# Every name below must have an A record pointing at THIS server's public IP.
BASE_DOMAIN=burjexprime.com
CRM_HOST=crm.burjexprime.com
API_HOST=api.burjexprime.com
WS_HOST=ws.burjexprime.com
ADMIN_HOST=admin.burjexprime.com
APP_HOST=app.burjexprime.com
FEED_HOST=feed.burjexprime.com

# Let's Encrypt registration address (Caddy issues + renews all certs).
ACME_EMAIL=ops@burjexprime.com

# ============================================================================
#  DJANGO CRM
# ============================================================================
DJANGO_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
DJANGO_DEBUG=0
# 127.0.0.1 and localhost are required: the container healthcheck requests
# http://127.0.0.1:8000/health/, and Django answers 400 for a Host it does not
# trust — which would keep crm-web permanently "unhealthy" and stop crm-worker
# and crm-beat from ever starting.
DJANGO_ALLOWED_HOSTS=crm.burjexprime.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.burjexprime.com
CORS_ALLOWED_ORIGINS=https://crm.burjexprime.com,https://app.burjexprime.com,https://admin.burjexprime.com

# TLS is terminated by Caddy, so Django must trust the forwarded proto and
# mark its cookies Secure. Do NOT enable SECURE_SSL_REDIRECT here — Caddy
# already redirects http→https, and doubling it causes redirect loops.
DJANGO_USE_X_FORWARDED_PROTO=1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000

SITE_BASE_URL=https://crm.burjexprime.com
CRM_STABILITY_MODE=stable
SERVICE_NAME=crm

# Process sizing. Rule of thumb: (2 x vCPU) + 1, capped by RAM.
CRM_WEB_WORKERS=3
CELERY_CONCURRENCY=4

# ── CRM Postgres (its own instance; never shared with B-Trader) ─────────────
POSTGRES_DB=burjexcrm
POSTGRES_USER=burjexcrm
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=crm-postgres
POSTGRES_PORT=5432

# ── CRM Redis (cache + sessions + Celery broker + Channels layer) ───────────
CRM_REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/1
CHANNELS_REDIS_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/2

# Celery beat drives the BTrader/MT5 reconcile tasks. The mobile app now gets
# balances over the WebSocket, so this is only the slow reconcile safety net.
BTRADER_SYNC_INTERVAL_SECONDS=10
MT5_SYNC_INTERVAL_SECONDS=60

# ── CRM outbound email ──────────────────────────────────────────────────────
# Only the backend is env-driven. settings.py does NOT read EMAIL_HOST /
# EMAIL_PORT / EMAIL_HOST_USER — the SMTP host, port and credentials are
# configured in the CRM admin UI and stored in the database, so putting them
# here would have no effect. CertifiEmailBackend verifies TLS against certifi's
# CA bundle, which avoids CERTIFICATE_VERIFY_FAILED on a bare Linux image.
DJANGO_EMAIL_BACKEND=admin_panel.mail_backend.CertifiEmailBackend

# ============================================================================
#  B-TRADER  (values mirror btrader/infra/.env.prod.example)
# ============================================================================
NODE_ENV=production

# ── B-Trader's OWN Postgres + Redis (separate from the CRM's) ───────────────
BT_POSTGRES_USER=btrader
BT_POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
BT_POSTGRES_DB=btrader
BT_REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# B-Trader's REDIS_URL is set per-service in the compose file (it must not
# collide with the CRM's REDIS_URL above, which is what Django reads).
DATABASE_URL=postgresql://btrader:CHANGE_ME_strong_db_password@btrader-postgres:5432/btrader?schema=public

# ── Auth secrets ────────────────────────────────────────────────────────────
# JWT_SECRET is shared by gateway-api and ws-gateway — they MUST match or every
# WebSocket connection is rejected with close code 4401.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d
ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters__

# ── CRM ↔ B-Trader integration ──────────────────────────────────────────────
# The CRM calls B-Trader over the internal Docker network (no public hop):
#     http://btrader-gateway:4100
# Set that as the "Base URL" on the CRM admin integration page (see README).
CRM_INTEGRATION_KEY=CHANGE_ME_shared_crm_service_key
# B-Trader posts account/balance/deal events back to the CRM here.
CRM_WEBHOOK_URL=https://crm.burjexprime.com/api/btrader/webhook/
CRM_WEBHOOK_SECRET=CHANGE_ME_shared_webhook_secret

# ── Price feed ──────────────────────────────────────────────────────────────
# mt5-ingest = live ticks pushed by the MT5 bridge/EA on the Windows VPS.
# EMPTY     = no prices at all (safe default; never silently mocks).
# mock      = synthetic feed, ONLY for smoke-testing a fresh install.
LP_BRIDGE_DRIVER=mt5-ingest
CHART_PROVIDER=internal

# Shared secret the Windows MT5 bridge/EA sends with every tick batch.
MT5_FEED_TOKEN=CHANGE_ME_openssl_rand_hex_24
# Broker symbol suffix to strip, e.g. ".r" maps EURUSD.r -> EURUSD. Blank = none.
MT5_SYMBOL_SUFFIX=
# Reject ticks older than N ms (0 = accept any age).
MT5_MAX_TICK_AGE_MS=0

# Separate, higher-privilege token for symbol/group reconcile + A-book covers.
# Deliberately NOT the same as MT5_FEED_TOKEN.
BRIDGE_TOKEN=CHANGE_ME_openssl_rand_hex_24

# SPACE-separated public IPs / CIDRs of the Windows MT5 VPS (Caddy's remote_ip
# matcher syntax, e.g. "203.0.113.10 198.51.100.0/24"). Caddy rejects feed
# traffic from anywhere else. Leave blank to allow any source — the
# MT5_FEED_TOKEN is still required either way.
FEED_ALLOWED_IPS=

LOG_LEVEL=info
