# ============================================================================
#  Burjex Prime — IP-ONLY production env (CRM + B-Trader, no domain, no TLS)
#
#  Copy to deploy/.env.prod.ip and then:
#    1. Replace EVERY occurrence of YOUR_VPS_IP with the server's public IP:
#         sed -i 's/YOUR_VPS_IP/203.0.113.10/g' deploy/.env.prod.ip
#       (docker compose does NOT expand variables inside an env_file, so the IP
#        has to appear literally on each line — hence the sed instead of a
#        single PUBLIC_HOST= reference.)
#    2. Replace every CHANGE_ME.  Generate secrets with:  openssl rand -hex 32
#
#  NEVER commit the filled-in .env.prod.ip (deploy/.gitignore excludes it).
#
#  ⚠  Everything below is plain HTTP. Passwords, JWTs, the MT5 feed token and
#     every tick cross the internet unencrypted, and anyone on the path can
#     read or replay them. This is acceptable for YOUR OWN testing only. Point
#     a domain at this box and switch to .env.prod + Caddyfile before a single
#     real client touches it.
# ============================================================================

# ── Public address ──────────────────────────────────────────────────────────
# Informational only (nothing interpolates it) — the real values are the
# literal IPs written into the Django settings further down, and Caddy binds
# every interface by port. Keep it in sync so `grep PUBLIC_HOST` tells the
# truth about which box this file belongs to.
PUBLIC_HOST=YOUR_VPS_IP

# Published host ports. Changing these means editing Caddyfile.ip AND
# docker-compose.ip.yml too — they are listed here as documentation, not as
# knobs that are read anywhere.
#   CRM 8000 | BT REST 4100 | BT WS 4101 | BT admin 4200 | MT5 ingest 4300
#   BT web trader 4400

# ============================================================================
#  DJANGO CRM
# ============================================================================
DJANGO_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
DJANGO_DEBUG=0

# Django strips the port before matching ALLOWED_HOSTS, so the bare IP covers
# http://IP:8000. 127.0.0.1 and localhost are REQUIRED: the container health
# check requests http://127.0.0.1:8000/health/ready/, and Django answers 400
# for an untrusted Host — which would keep crm-web permanently "unhealthy" and
# stop crm-worker and crm-beat from ever starting.
DJANGO_ALLOWED_HOSTS=YOUR_VPS_IP,127.0.0.1,localhost

# CSRF origins DO need the scheme and the port (Django compares the full
# origin). Without this the admin login form fails with "CSRF verification
# failed / Origin checking failed".
DJANGO_CSRF_TRUSTED_ORIGINS=http://YOUR_VPS_IP:8000

# Browsers that will call the CRM API cross-origin: the B-Trader admin and web
# trader bundles. The mobile app is not a browser and needs no CORS entry.
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP:8000,http://YOUR_VPS_IP:4200,http://YOUR_VPS_IP:4400

# There is no HTTPS anywhere in this mode, so all three must stay off:
#  - Secure cookies would never be sent back over http and login would loop.
#  - SECURE_SSL_REDIRECT would redirect to an https:// URL that does not exist.
#  - HSTS on a bare IP would poison the browser for the day you do add TLS.
DJANGO_USE_X_FORWARDED_PROTO=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0

SITE_BASE_URL=http://YOUR_VPS_IP:8000
CRM_STABILITY_MODE=stable
SERVICE_NAME=crm

# Process sizing. Rule of thumb: (2 x vCPU) + 1, capped by RAM.
CRM_WEB_WORKERS=3
CELERY_CONCURRENCY=4

# ── CRM Postgres (its own instance; never shared with B-Trader) ─────────────
POSTGRES_DB=burjexcrm
POSTGRES_USER=burjexcrm
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=crm-postgres
POSTGRES_PORT=5432

# ── CRM Redis (cache + sessions + Celery broker + Channels layer) ───────────
# The password below must match CRM_REDIS_PASSWORD in all three URLs.
CRM_REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/1
CHANNELS_REDIS_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/2

# Celery beat drives the BTrader/MT5 reconcile tasks. The mobile app gets
# balances over the WebSocket, so this is only the slow reconcile safety net.
BTRADER_SYNC_INTERVAL_SECONDS=10
MT5_SYNC_INTERVAL_SECONDS=60

# ── CRM outbound email ──────────────────────────────────────────────────────
# Only the backend is env-driven; the SMTP host, port and credentials are
# configured in the CRM admin UI and stored in the database.
DJANGO_EMAIL_BACKEND=admin_panel.mail_backend.CertifiEmailBackend

# ============================================================================
#  B-TRADER
# ============================================================================
NODE_ENV=production

# ── B-Trader's OWN Postgres + Redis (separate from the CRM's) ───────────────
BT_POSTGRES_USER=btrader
BT_POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
BT_REDIS_PASSWORD=CHANGE_ME_strong_redis_password
BT_POSTGRES_DB=btrader

# The password inside DATABASE_URL must equal BT_POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://btrader:CHANGE_ME_strong_db_password@btrader-postgres:5432/btrader?schema=public
# Fully-formed URLs used by docker-compose.ip.yml for btrader-market-data (and
# preferred for other BT services). Prevents empty ${BT_*} expansion when
# compose is invoked without --env-file.
BTRADER_DATABASE_URL=postgresql://btrader:CHANGE_ME_strong_db_password@btrader-postgres:5432/btrader?schema=public&connection_limit=5
BTRADER_REDIS_URL=redis://:CHANGE_ME_strong_redis_password@btrader-redis:6379

# ── Auth secrets ────────────────────────────────────────────────────────────
# JWT_SECRET is shared by gateway-api and ws-gateway — they MUST match or every
# WebSocket connection is rejected with close code 4401.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d
ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters__

# ── Tenant ──────────────────────────────────────────────────────────────────
# With no domain there is no Host header to resolve a tenant from, so clients
# identify themselves with the X-BT-Tenant header instead. The Flutter apps
# send it automatically from --dart-define=TENANT=<slug> (default `demo`), and
# `demo` is exactly the slug the Prisma seed creates. Keep this in sync with
# the TENANT define you build the apps with.
BT_DEFAULT_TENANT=demo

# ── CRM ↔ B-Trader integration ──────────────────────────────────────────────
# The CRM calls B-Trader over the internal Docker network (no public hop, and
# therefore no plaintext exposure for this leg):
#     http://btrader-gateway:4100
# Set that as the "Base URL" on the CRM admin integration page.
CRM_INTEGRATION_KEY=CHANGE_ME_shared_crm_service_key
# B-Trader posts account/balance/deal events back to the CRM here. Container to
# container this could be http://crm-web:8000/..., but the B-Trader admin UI
# stores one webhook URL and the public form is easier to verify with curl.
CRM_WEBHOOK_URL=http://YOUR_VPS_IP:8000/api/btrader/webhook/
CRM_WEBHOOK_SECRET=CHANGE_ME_shared_webhook_secret

# ── Price feed ──────────────────────────────────────────────────────────────
# mt5-ingest = live ticks pushed by the MT5 bridge/EA on the Windows VPS.
# EMPTY     = no prices at all (safe default; never silently mocks).
# mock      = synthetic feed, ONLY for smoke-testing a fresh install.
LP_BRIDGE_DRIVER=mt5-ingest
CHART_PROVIDER=internal

# Shared secret the Windows MT5 bridge/EA sends with every tick batch, as the
# X-Feed-Token header, to http://YOUR_VPS_IP:4300/ingest.
MT5_FEED_TOKEN=CHANGE_ME_openssl_rand_hex_24
# Broker symbol suffix to strip, e.g. ".r" maps EURUSD.r -> EURUSD. Blank = none.
MT5_SYMBOL_SUFFIX=
# Reject ticks older than N ms (0 = accept any age).
MT5_MAX_TICK_AGE_MS=0

# Durable candle flush (market-data) — keep /ingest tick ACKs snappy under history load.
# Compose defaults match these; override only if needed.
CANDLE_FLUSH_SCAN_MS=5000
CANDLE_TIP_MIN_MS=20000
CANDLE_BATCH_SIZE=80
CANDLE_MAX_PER_FLUSH=400
CANDLE_FLUSH_YIELD_MS=75
CANDLE_HISTORY_QUEUE_CAP=40000

# Separate, higher-privilege token for symbol/group reconcile + A-book covers.
# Deliberately NOT the same as MT5_FEED_TOKEN.
BRIDGE_TOKEN=CHANGE_ME_openssl_rand_hex_24

# SPACE-separated public IPs / CIDRs of the Windows MT5 VPS (Caddy's remote_ip
# matcher syntax, e.g. "203.0.113.10 198.51.100.0/24"). Caddy rejects feed
# traffic from anywhere else. Leaving it blank allows any source.
#
# In IP mode this is close to mandatory: the feed token crosses the wire in
# plaintext, so the allowlist is the only thing that survives someone sniffing
# it. Fill it in before you start the bridge.
FEED_ALLOWED_IPS=

LOG_LEVEL=info
