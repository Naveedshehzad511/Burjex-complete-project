# ============================================================================
#  Burjex Prime — IP-ONLY edge (no domain, no TLS).
#
#  Use this instead of ./Caddyfile when the server has a bare IP and no DNS.
#  Let's Encrypt cannot issue a certificate for an IP address, so `auto_https
#  off` is mandatory: without it Caddy would try (and fail) to provision certs
#  and then refuse to serve.
#
#  Routing is BY PORT, not by hostname or path:
#     :8000  Django CRM (portal, admin, /api/v1, /static, /media, live chat WS)
#     :4100  B-Trader REST gateway
#     :4101  B-Trader WebSocket
#     :4200  B-Trader admin dashboard (Flutter web, static)
#     :4300  MT5 tick ingest
#     :4400  B-Trader web trader (Flutter web, static, optional)
#
#  Why port-based and not path-based: the ws-gateway listens on the ROOT path
#  and authenticates from `?token=`, and the Flutter clients build their URL as
#  '$wsUrl?token=…' with no path segment. A `/ws` prefix would need rewriting on
#  the proxy AND a client change. One port per service avoids both.
#
#  Tenant resolution still works without hostnames: TenantMiddleware checks the
#  X-BT-Tenant header BEFORE the Host header, and the Flutter clients always
#  send it from `--dart-define=TENANT=<slug>` (default `demo`).
#
#  Caddy still fronts every service here rather than publishing the containers
#  directly, because Django has no WhiteNoise in this project — with DEBUG=0 it
#  does not serve /static or /media at all. Caddy serves both off disk.
# ============================================================================

{
	auto_https off
	admin off
}

# ── Reusable snippets ───────────────────────────────────────────────────────

# Plain request/response proxying (REST).
(api_proxy) {
	reverse_proxy {args[0]} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			dial_timeout 10s
			read_timeout 120s
		}
	}
}

# Streaming/WebSocket proxying: no read timeout, no response buffering.
# Caddy performs the Upgrade handshake itself — there is no Nginx-style
# `proxy_set_header Upgrade` to write. What must be set is the transport
# timeout, or an idle price socket gets torn down.
(ws_proxy) {
	reverse_proxy {args[0]} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
		transport http {
			dial_timeout 10s
			read_timeout 0
			write_timeout 0
		}
	}
}

# No Strict-Transport-Security here: there is no TLS to pin, and a stray HSTS
# header would be a footgun the day this IP does get a certificate.
(ip_headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(spa_site) {
	import ip_headers
	root * {args[0]}
	encode zstd gzip
	try_files {path} {path}/ /index.html
	file_server
	@immutable path *.js *.css *.woff2 *.png *.svg
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}

# ============================================================================
#  CRM site body — shared by :8000 (legacy app) and :80 (mobile/carrier-safe).
# ============================================================================
(crm_site) {
	import ip_headers

	# Collected static + uploaded media come straight off disk (never Django —
	# this project has no WhiteNoise, so DEBUG=0 would 404 them).
	handle_path /static/* {
		root * /srv/crm/static
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}
	handle_path /media/* {
		root * /srv/crm/media
		file_server
	}

	# Django Channels (live_chat) — same port, needs the streaming transport.
	@crm_ws path /ws/*
	handle @crm_ws {
		import ws_proxy crm-web:8000
	}

	handle {
		import api_proxy crm-web:8000
	}

	request_body {
		max_size 25MB
	}
	encode zstd gzip
}

# ============================================================================
#  :8000 — Django CRM (ASGI). Admin + client portal + /api/v1 + live chat WS.
#          http://<VPS_IP>:8000/
# ============================================================================
:8000 {
	import crm_site
}

# ============================================================================
#  :80 — same CRM edge on standard HTTP (many mobile carriers block :8000).
#          http://<VPS_IP>/api/v1/
# ============================================================================
:80 {
	import crm_site
}

# ============================================================================
#  :4100 — B-Trader REST gateway (gateway-api). Swagger at /docs, API at /v1.
#          http://<VPS_IP>:4100/v1
# ============================================================================
:4100 {
	import ip_headers
	import api_proxy btrader-gateway:4100
	request_body {
		max_size 10MB
	}
	encode zstd gzip
}

# ============================================================================
#  :4101 — B-Trader WebSocket (ws-gateway).
#          ws://<VPS_IP>:4101   (no path, no trailing slash — the client
#          appends `?token=<accessJWT>` itself)
#
#  Do NOT add `encode` here: compressing a socket adds latency and defeats the
#  per-frame flush that keeps ticks instant.
# ============================================================================
:4101 {
	import ip_headers
	import ws_proxy btrader-ws:4101
}

# ============================================================================
#  :4200 — B-Trader admin dashboard (static Flutter web build rsynced to
#          /opt/burjex/web/admin on the host).
#          http://<VPS_IP>:4200/
# ============================================================================
:4200 {
	import spa_site /srv/btrader-admin
}

# ============================================================================
#  :4300 — MT5 price ingest. The Windows MT5 bridge POSTs tick batches to
#          http://<VPS_IP>:4300/ingest with the X-Feed-Token header.
#
#  Published on 4300, NOT 4200: the market-data container listens on 4200
#  internally (MT5_INGEST_PORT), and 4200 on the host is taken by the admin
#  dashboard above. The internal port is unchanged; only the host port differs.
#
#  Set FEED_ALLOWED_IPS to the bridge VPS IP(s) to lock this down — this is the
#  one endpoint reachable from the open internet by design, and over plain HTTP
#  the token travels in the clear, so the IP allowlist matters more here than
#  it does in the TLS setup.
# ============================================================================
:4300 {
	import ip_headers

	@blocked not remote_ip {$FEED_ALLOWED_IPS:0.0.0.0/0 ::/0}
	respond @blocked "forbidden" 403

	import api_proxy btrader-market-data:4200
}

# ============================================================================
#  :4400 — B-Trader web trader (static Flutter web build). Optional; the port
#          simply 404s until you rsync a build to /opt/burjex/web/trader.
# ============================================================================
:4400 {
	import spa_site /srv/btrader-trader
}
