# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
BASE_DOMAIN=btrader.io
API_PORT=4100
WS_PORT=4101
ENGINE_PORT=4102
MARKET_DATA_PORT=4103
ADMIN_PORT=4200

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://btrader:btrader@localhost:5433/btrader?schema=public

# ─── Redis (events, cache, pub/sub, rate-limit) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d   # persistent sessions: end via sign-out/admin disable/delete, not time
ENCRYPTION_KEY=btrader-32char-encryption-key!!!

# ─── CRM integration (Example) — HMAC-signed service-to-service ───────────────
# B-Trader exposes /v1/crm/* ; CRM calls these with the shared key + HMAC sig.
CRM_INTEGRATION_KEY=shared-crm-service-key
CRM_WEBHOOK_URL=https://api.example.com/integrations/btrader/webhook
CRM_WEBHOOK_SECRET=shared-webhook-secret

# ─── Liquidity Provider Bridge (WebSocket price feed) ─────────────────────────
# Generic adapter; configure per bridge (e.g. PrimeXM, oneZero, cTrader FIX/WS).
LP_BRIDGE_DRIVER=mock          # mock | generic-ws | fix
LP_BRIDGE_WS_URL=wss://lp.example.com/stream
LP_BRIDGE_API_KEY=
LP_BRIDGE_API_SECRET=

# ─── Chart data feed (server-side; keys never reach the client) ───────────────
# Provider for /v1/market/candles. Options: native | twelvedata | binance | polygon
CHART_PROVIDER=native
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
# (binance needs no key for public candles)

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
