# ============================================================================
#  B-Trader PRODUCTION env (co-hosted with the CRM on Hetzner).
#  Copy to infra/.env.prod and fill in. Generate secrets with:
#     openssl rand -hex 32
#  NEVER commit the filled-in .env.prod.
# ============================================================================

NODE_ENV=production
BASE_DOMAIN=btrader.example.com

# ── B-Trader's OWN database + redis (separate from the CRM's) ────────────────
BT_POSTGRES_USER=btrader
BT_POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
BT_POSTGRES_DB=btrader
BT_REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# These are consumed inside containers (internal hostnames + default ports).
DATABASE_URL=postgresql://btrader:CHANGE_ME_strong_db_password@btrader-postgres:5432/btrader?schema=public
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@btrader-redis:6379

# ── Auth secrets ─────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d   # persistent sessions: end via sign-out/admin disable/delete, not time
ENCRYPTION_KEY=CHANGE_ME_32_char_key____________

# ── CRM integration (the CRM calls B-Trader with this shared key + HMAC) ─────
# Internally the CRM can reach B-Trader at http://btrader-gateway:4100/v1/crm/*
CRM_INTEGRATION_KEY=CHANGE_ME_shared_crm_service_key
CRM_WEBHOOK_URL=https://api.example.com/integrations/btrader/webhook
CRM_WEBHOOK_SECRET=CHANGE_ME_shared_webhook_secret

# ── Chart/price feed — keep mock until you purchase a provider ───────────────
CHART_PROVIDER=native
LP_BRIDGE_DRIVER=mock

LOG_LEVEL=info
