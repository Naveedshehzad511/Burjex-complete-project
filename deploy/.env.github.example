# Isolated GitHub / burjexprime.net env. Copy to deploy/.env.github on the server.
# Live duafx.com stack uses deploy/.env.prod.ip — do not mix them.

PUBLIC_HOST=5.226.139.8
BASE_DOMAIN=burjexprime.net
CRM_HOST=crm.burjexprime.net
API_HOST=api.burjexprime.net
WS_HOST=ws.burjexprime.net
ADMIN_HOST=admin.burjexprime.net
APP_HOST=app.burjexprime.net
FEED_HOST=feed.burjexprime.net
PORTAL_HOST=portal.burjexprime.net
ACME_EMAIL=ops@burjexprime.net

DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=crm.burjexprime.net,portal.burjexprime.net,burjexprime.net,www.burjexprime.net,5.226.139.8,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.burjexprime.net,http://crm.burjexprime.net,https://portal.burjexprime.net,https://burjexprime.net,http://5.226.139.8:6800,http://5.226.139.8
CORS_ALLOWED_ORIGINS=https://crm.burjexprime.net,https://app.burjexprime.net,https://admin.burjexprime.net,https://portal.burjexprime.net,http://5.226.139.8:6200,http://5.226.139.8:6400,http://5.226.139.8:6500,http://5.226.139.8:6800

# IP:6800 is plain HTTP until DNS/TLS; Secure cookies would drop the CSRF cookie and login 403s.
DJANGO_USE_X_FORWARDED_PROTO=1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_CSRF_COOKIE_NAME=bxnet_csrftoken
DJANGO_SESSION_COOKIE_NAME=bxnet_sessionid

SITE_BASE_URL=https://crm.burjexprime.net
CRM_STABILITY_MODE=stable
SERVICE_NAME=crm
CRM_WEB_WORKERS=1
CELERY_CONCURRENCY=2

POSTGRES_DB=burjexcrm
POSTGRES_USER=burjexcrm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=crm-postgres
POSTGRES_PORT=5432

CRM_REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@crm-redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME@crm-redis:6379/1
CHANNELS_REDIS_URL=redis://:CHANGE_ME@crm-redis:6379/2

BTRADER_SYNC_INTERVAL_SECONDS=10
MT5_SYNC_INTERVAL_SECONDS=60
DJANGO_EMAIL_BACKEND=admin_panel.mail_backend.CertifiEmailBackend

NODE_ENV=production
BT_POSTGRES_USER=btrader
BT_POSTGRES_PASSWORD=CHANGE_ME
BT_REDIS_PASSWORD=CHANGE_ME
BT_POSTGRES_DB=btrader
DATABASE_URL=postgresql://btrader:CHANGE_ME@btrader-postgres:5432/btrader?schema=public
BTRADER_DATABASE_URL=postgresql://btrader:CHANGE_ME@btrader-postgres:5432/btrader?schema=public&connection_limit=5
BTRADER_REDIS_URL=redis://:CHANGE_ME@btrader-redis:6379

JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d
ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters__
BT_DEFAULT_TENANT=demo
CRM_INTEGRATION_KEY=CHANGE_ME
CRM_WEBHOOK_URL=http://crm-web:8000/api/btrader/webhook/
CRM_WEBHOOK_SECRET=CHANGE_ME

LP_BRIDGE_DRIVER=mt5-ingest
CHART_PROVIDER=internal
BROKER_UTC_OFFSET_SEC=10800
CANDLE_FLUSH_SCAN_MS=5000
CANDLE_TIP_MIN_MS=20000
CANDLE_BATCH_SIZE=80
CANDLE_MAX_PER_FLUSH=400
CANDLE_FLUSH_YIELD_MS=75
CANDLE_HISTORY_QUEUE_CAP=40000
MT5_FEED_TOKEN=CHANGE_ME
MT5_SYMBOL_SUFFIX=
MT5_MAX_TICK_AGE_MS=0
BRIDGE_TOKEN=CHANGE_ME
FEED_ALLOWED_IPS=0.0.0.0/0
LOG_LEVEL=info

BURJEX_WEB_ADMIN=C:/Burjex-complete-project/web/admin
BURJEX_WEB_TRADER=C:/Burjex-complete-project/web/trader
BURJEX_WEB_PORTAL=C:/Burjex-complete-project/web/portal
