# Burjex Prime — production env for docker-compose.live.yml + Caddyfile.live.
#
# Copy to deploy/.env.live on the SERVER (never commit the filled-in file —
# deploy/.gitignore already excludes it). Fill every CHANGE_ME. Generate
# secrets with:  openssl rand -hex 32   (or -hex 24 for the shorter ones)

PUBLIC_HOST=5.226.139.8
BASE_DOMAIN=burjexprime.net
CRM_HOST=crm.burjexprime.net
API_HOST=api.burjexprime.net
WS_HOST=ws.burjexprime.net
ADMIN_HOST=admin.burjexprime.net
APP_HOST=app.burjexprime.net
FEED_HOST=feed.burjexprime.net
PORTAL_HOST=portal.burjexprime.net
ACME_EMAIL=ops@burjexprime.net

# ============================================================================
#  DJANGO CRM
# ============================================================================
DJANGO_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=crm.burjexprime.net,portal.burjexprime.net,burjexprime.net,www.burjexprime.net,5.226.139.8,127.0.0.1,localhost,crm-web
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.burjexprime.net,https://portal.burjexprime.net,https://admin.burjexprime.net,https://burjexprime.net
CORS_ALLOWED_ORIGINS=https://crm.burjexprime.net,https://app.burjexprime.net,https://admin.burjexprime.net,https://portal.burjexprime.net
# This Caddy terminates real TLS and forwards the original scheme, so Django
# can trust the header to tell HTTP from HTTPS.
DJANGO_USE_X_FORWARDED_PROTO=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
SITE_BASE_URL=https://crm.burjexprime.net
CRM_STABILITY_MODE=stable
SERVICE_NAME=crm
CRM_WEB_WORKERS=2
CELERY_CONCURRENCY=2
# Fixed code that verifies ANY new account at signup (portal app + CRM website). Not used for password reset.
# Change the digits, or leave the value empty to switch it off.
CLIENT_OTP_STATIC_CODE=373737

POSTGRES_DB=burjexcrm
POSTGRES_USER=burjexcrm
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=crm-postgres
POSTGRES_PORT=5432

CRM_REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/1
CHANNELS_REDIS_URL=redis://:CHANGE_ME_strong_redis_password@crm-redis:6379/2

BTRADER_SYNC_INTERVAL_SECONDS=10
MT5_SYNC_INTERVAL_SECONDS=60

# Real SMTP is NOT wired up in the code yet (config/settings.py has no
# EMAIL_HOST/PORT/USER/PASSWORD read from env) — password-reset / KYC emails
# will fail to send until that's added. Ask Claude to add it if you need real
# email at launch; leave as console backend (logs only) until then.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ============================================================================
#  B-TRADER
# ============================================================================
NODE_ENV=production
BT_POSTGRES_USER=btrader
BT_POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
BT_REDIS_PASSWORD=CHANGE_ME_strong_redis_password
BT_POSTGRES_DB=btrader
DATABASE_URL=postgresql://btrader:CHANGE_ME_strong_db_password@btrader-postgres:5432/btrader?schema=public
BTRADER_DATABASE_URL=postgresql://btrader:CHANGE_ME_strong_db_password@btrader-postgres:5432/btrader?schema=public&connection_limit=5
BTRADER_REDIS_URL=redis://:CHANGE_ME_strong_redis_password@btrader-redis:6379

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d
ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters__
BT_DEFAULT_TENANT=demo

# Shared secret between gateway-api and btrader-matching, sent as
# x-engine-token. Both containers read the SAME var from this one file, so
# setting it here is enough — nothing else to sync.
RUST_ENGINE_TOKEN=CHANGE_ME_openssl_rand_hex_24

CRM_INTEGRATION_KEY=CHANGE_ME_shared_crm_service_key
CRM_WEBHOOK_URL=http://crm-web:8000/api/btrader/webhook/
CRM_WEBHOOK_SECRET=CHANGE_ME_shared_webhook_secret

# mock = simulated prices, safe for client UAT with no real MT5 feed yet.
# mt5-ingest = real ticks from the Windows MT5 bridge. Switch to this only
# once the bridge is actually running and FEED_ALLOWED_IPS below is locked
# down — with LP_BRIDGE_DRIVER=mt5-ingest, anyone who can reach
# https://feed.burjexprime.net could otherwise inject fake prices.
LP_BRIDGE_DRIVER=mock
CHART_PROVIDER=internal
MT5_FEED_TOKEN=CHANGE_ME_openssl_rand_hex_24
MT5_SYMBOL_SUFFIX=
MT5_MAX_TICK_AGE_MS=0
BRIDGE_TOKEN=CHANGE_ME_openssl_rand_hex_24
# 0.0.0.0/0 = anyone. Set to the MT5 bridge server's IP(s) before switching
# LP_BRIDGE_DRIVER to mt5-ingest — space-separated, e.g. "203.0.113.10".
FEED_ALLOWED_IPS=0.0.0.0/0

LOG_LEVEL=info

# ============================================================================
#  ADMIN / DEMO USERS - created and kept in sync from here on EVERY start. Change a value, restart
#  (docker compose ... up -d) and that user's password / account follows. Nothing is created by a script
#  with a hard-coded default. Changing an EMAIL creates a new user; the old one stays until you
#  deactivate it. Customers are NOT created here - they register in the app (signup OTP = CLIENT_OTP_STATIC_CODE).
# ============================================================================
# CRM admin (crm.burjexprime.net/admin and the CRM admin pages)
CRM_ADMIN_EMAIL=admin@burjexprime.net
CRM_ADMIN_PASSWORD=CHANGE_ME_strong_password
# B-Trader platform super admin (no tenant)
BT_SUPER_ADMIN_EMAIL=superadmin@burjexprime.net
BT_SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password
# B-Trader tenant admin: the login of the admin dashboard (admin.burjexprime.net). Needs the "demo" tenant -
# created by the one-time seed (see docker-compose.live.yml header).
BT_TENANT_ADMIN_EMAIL=tradingadmin@burjexprime.net
BT_TENANT_ADMIN_PASSWORD=CHANGE_ME_strong_password
# B-Trader demo trader + its demo account (also needs the seeded tenant)
BT_DEMO_TRADER_EMAIL=demotrader@burjexprime.net
BT_DEMO_TRADER_PASSWORD=CHANGE_ME_strong_password
BT_DEMO_TRADER_ACCOUNT_LOGIN=500001

# Web builds Caddy serves — real folders ON THIS SERVER (not your laptop).
# Create them and robocopy `flutter build web` output into each.
BURJEX_WEB_ADMIN=C:/burjex/web/admin
BURJEX_WEB_PORTAL=C:/burjex/web/portal

BROKER_UTC_OFFSET_SEC=10800
CANDLE_FLUSH_SCAN_MS=5000
CANDLE_TIP_MIN_MS=20000
CANDLE_BATCH_SIZE=80
CANDLE_MAX_PER_FLUSH=400
CANDLE_FLUSH_YIELD_MS=75
CANDLE_HISTORY_QUEUE_CAP=40000
ENGINE_FAST_INTERVAL_MS=40
ENGINE_TICK_INTERVAL_MS=250
ENGINE_TICK_CONCURRENCY=4
ACCOUNT_QUEUE_WAIT_MS=8000
MAX_PRICE_AGE_MS=8000
