# Appended to live Caddyfile.ip — TLS for burjexprime.net only.
# Only hostnames that currently have DNS A records. Names without DNS
# (api/ws/app/feed/www) make Caddy fail the TLS handshake (no certificate).
# Proxies to the isolated GitHub stack. Does not change duafx.com sites.

(net_to_host) {
	reverse_proxy bxnet_caddy:{args[0]} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
		transport http {
			dial_timeout 10s
			read_timeout 0
			write_timeout 0
		}
	}
}

crm.burjexprime.net {
	import tls_headers
	import net_to_host 6800
}

# Portal SPA plus same-origin B-Trader API/WS so the HTTPS page is not mixed-content.
portal.burjexprime.net {
	import tls_headers
	@portal_ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @portal_ws {
		import net_to_host 6101
	}
	handle /v1/* {
		import net_to_host 6100
	}
	handle {
		import net_to_host 6500
	}
}

# Admin SPA plus same-origin API/WS (api.burjexprime.net / ws.burjexprime.net have no DNS yet).
admin.burjexprime.net {
	import tls_headers
	@admin_ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @admin_ws {
		import net_to_host 6101
	}
	handle /v1/* {
		import net_to_host 6100
	}
	handle {
		import net_to_host 6200
	}
}
